{
  "--bg": "#000000",
  "--brand-bg": "#000000",
  "--brand-faint": "#7a7a7e",
  "--brand-faint-contrast": "#a4a4a8",
  "--brand-fg": "#f2f2f2",
  "--brand-font-grotesk": "\"Archivo Variable\", \"Archivo\", \"Onest Variable\", \"Archivo Fallback\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
  "--brand-font-mono": "\"IBM Plex Mono\", ui-monospace, \"SFMono-Regular\", Menlo, monospace",
  "--brand-ink": "#f2f2f2",
  "--brand-ink-fg": "#000000",
  "--brand-line": "#1b1b1d",
  "--brand-line-2": "#2c2c30",
  "--brand-line-2-contrast": "#707074",
  "--brand-line-contrast": "#5a5a5e",
  "--brand-muted": "#8c8c90",
  "--brand-muted-contrast": "#b4b4b8",
  "--brand-scroll-shadow": "rgba(242, 242, 242, 0.16)",
  "--dur-base": "160ms",
  "--dur-fast": "120ms",
  "--dur-slow": "280ms",
  "--ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
  "--ease-soft": "ease",
  "--faint": "#a4a4a8",
  "--fg": "#f2f2f2",
  "--font-body": "\"Archivo Variable\", \"Archivo\", \"Onest Variable\", \"Archivo Fallback\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
  "--font-display": "\"Archivo Variable\", \"Archivo\", \"Onest Variable\", \"Archivo Fallback\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
  "--font-grotesk": "\"Archivo Variable\", \"Archivo\", \"Onest Variable\", \"Archivo Fallback\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
  "--font-meta": "\"Archivo Variable\", \"Archivo\", \"Onest Variable\", \"Archivo Fallback\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
  "--font-mono": "\"IBM Plex Mono\", ui-monospace, \"SFMono-Regular\", Menlo, monospace",
  "--gut": "clamp(20px, 5vw, 72px)",
  "--ink": "#f2f2f2",
  "--ink-fg": "#000000",
  "--label-case": "uppercase",
  "--label-font": "\"Archivo Variable\", \"Archivo\", \"Onest Variable\", \"Archivo Fallback\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
  "--label-track": "0.12em",
  "--label-weight": "600",
  "--line": "#5a5a5e",
  "--line-2": "#707074",
  "--maxw": "1200px",
  "--muted": "#b4b4b8",
  "--r-circle": "50%",
  "--r-md": "10px",
  "--r-pill": "999px",
  "--r-sm": "6px",
  "--r-xs": "2px",
  "--scale": "1",
  "--scrim": "color-mix(in srgb, #000 58%, transparent)",
  "--scroll-shadow": "rgba(242, 242, 242, 0.16)",
  "--section-pad": "clamp(64px, 8vh, 112px)",
  "--t-body": "calc(clamp(1rem, 1.1vw, 1.1rem) * 1)",
  "--t-h1": "calc(clamp(2.4rem, 6vw, 4.6rem) * 1)",
  "--t-h2": "calc(clamp(1.7rem, 3.2vw, 2.6rem) * 1)",
  "--t-h3": "calc(clamp(1.2rem, 1.8vw, 1.5rem) * 1)",
  "--t-lead": "calc(clamp(1.1rem, 1.6vw, 1.45rem) * 1)",
  "--t-mega": "calc(clamp(3rem, 11vw, 9rem)   * 1)",
  "--t-meta": "calc(clamp(0.78rem, 0.9vw, 0.9rem) * 1)",
  "--tap-highlight": "color-mix(in srgb, #f2f2f2 10%, transparent)",
  "--w-display": "600",
  "--w-name": "600",
  "--w-strong": "600",
  "--z-below": "-1",
  "--z-modal": "220",
  "--z-nav": "50",
  "--z-overlay": "200",
  "--z-skip": "100",
  ".hs-app --hs-dim": "color-mix(in srgb, #f2f2f2 45%, transparent)",
  ".hs-app --hs-inv-bg": "#f2f2f2",
  ".hs-app --hs-inv-fg": "#000000",
  ".hs-app --hs-inv-ink": "#000000",
  ".hs-app --hs-inv-ink-fg": "#f2f2f2",
  ".hs-app --hs-inv-line-2": "color-mix(in srgb, #000000 18%, #f2f2f2)",
  ".hs-app --hs-inv-muted": "color-mix(in srgb, #000000 58%, #f2f2f2)",
  ".hs-app --hs-t-h1": "min(calc(clamp(2.4rem, 6vw, 4.6rem) * 1), 3rem)",
  ".hs-app --hs-t-h2": "min(calc(clamp(1.7rem, 3.2vw, 2.6rem) * 1), 2rem)",
  ".hs-app --hs-wash": "color-mix(in srgb, #f2f2f2 9%, transparent)"
}