{
  "name": "hushsend",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test -c tests/a11y/playwright.config.ts",
    "visual": "playwright test -c visual/playwright.config.ts",
    "visual:update": "playwright test -c visual/playwright.config.ts --update-snapshots",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@noble/curves": "^2.0.0",
    "@reduxjs/toolkit": "^2.5.0",
    "barcode-detector": "^3.2.0",
    "client-zip": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "stark-ui-kit": "github:maksimfrelikh/stark-ui-kit#v0.3.2",
    "zod": "^4.6.5",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "hush-signaling-server": "github:maksimfrelikh/hush-signaling-server#9892fde2aa1d8ff5d588d02e8ee68af9e0816387",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "github:maksimfrelikh/stark-ui-kit#e08697faa19c9c5b3899cc6ecb3657cf82162ea6": true
  }
}
